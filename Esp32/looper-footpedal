#include <Arduino.h>
#include <PinButton.h>

// Define pins for footswitches and LEDs
const int footswitch1Pin = 2; // Footswitch 1: Record/Overdub
const int footswitch2Pin = 3; // Footswitch 2: Play/Stop
const int redLEDPin = 4;      // Red LED
const int greenLEDPin = 5;    // Green LED

// Define states using an enum
enum State {
  IDLE,
  RECORDING,
  PLAYBACK,
  OVERDUB,
  STOPPED
};

// Variable to track the current state, starting at IDLE
State currentState = IDLE;

// Create PinButton objects for the footswitches
PinButton footswitch1(footswitch1Pin);
PinButton footswitch2(footswitch2Pin);

// Variables for flashing the green LED in STOPPED state
unsigned long lastFlashTime = 0;
const unsigned long flashInterval = 500; // Flash every 500ms
bool greenLedState = false;

void setup() {
  // Configure pin modes
  pinMode(footswitch1Pin, INPUT_PULLUP); // Footswitch 1 with internal pull-up
  pinMode(footswitch2Pin, INPUT_PULLUP); // Footswitch 2 with internal pull-up
  pinMode(redLEDPin, OUTPUT);            // Red LED as output
  pinMode(greenLEDPin, OUTPUT);          // Green LED as output
  
  // Initialize LEDs to off
  digitalWrite(redLEDPin, LOW);
  digitalWrite(greenLEDPin, LOW);
}

void loop() {
  // Update the state of the footswitches
  footswitch1.update();
  footswitch2.update();

  // State machine logic based on current state and button actions
  switch (currentState) {
    case IDLE:
      // Press Footswitch 1 to start recording
      if (footswitch1.isSingleClick()) {
        currentState = RECORDING;
      }
      break;

    case RECORDING:
      // Press Footswitch 1 to play the loop
      if (footswitch1.isSingleClick()) {
        currentState = PLAYBACK;
      }
      // Press Footswitch 2 to stop recording
      else if (footswitch2.isSingleClick()) {
        currentState = STOPPED;
      }
      break;

    case PLAYBACK:
      // Press Footswitch 1 to overdub
      if (footswitch1.isSingleClick()) {
        currentState = OVERDUB;
      }
      // Press Footswitch 2 to stop playback
      else if (footswitch2.isSingleClick()) {
        currentState = STOPPED;
      }
      break;

    case OVERDUB:
      // Press Footswitch 1 to return to playback
      if (footswitch1.isSingleClick()) {
        currentState = PLAYBACK;
      }
      // Press Footswitch 2 to stop overdubbing
      else if (footswitch2.isSingleClick()) {
        currentState = STOPPED;
      }
      break;

    case STOPPED:
      // Press Footswitch 1 to overdub the stopped loop
      if (footswitch1.isSingleClick()) {
        currentState = OVERDUB;
      }
      // Press Footswitch 2 to play the loop
      else if (footswitch2.isSingleClick()) {
        currentState = PLAYBACK;
      }
      // Hold Footswitch 2 to clear the loop and return to Idle
      else if (footswitch2.isHold()) {
        currentState = IDLE;
      }
      break;
  }

  // Update the LEDs based on the current state
  updateLEDs();
}

// Function to control LEDs based on the current state
void updateLEDs() {
  switch (currentState) {
    case IDLE:
      // Both LEDs off
      digitalWrite(redLEDPin, LOW);
      digitalWrite(greenLEDPin, LOW);
      break;

    case RECORDING:
      // Red LED on, Green LED off
      digitalWrite(redLEDPin, HIGH);
      digitalWrite(greenLEDPin, LOW);
      break;

    case PLAYBACK:
      // Red LED off, Green LED on
      digitalWrite(redLEDPin, LOW);
      digitalWrite(greenLEDPin, HIGH);
      break;

    case OVERDUB:
      // Both LEDs on
      digitalWrite(redLEDPin, HIGH);
      digitalWrite(greenLEDPin, HIGH);
      break;

    case STOPPED:
      // Red LED off, Green LED flashing
      digitalWrite(redLEDPin, LOW);
      if (millis() - lastFlashTime >= flashInterval) {
        lastFlashTime = millis();
        greenLedState = !greenLedState;
        digitalWrite(greenLEDPin, greenLedState ? HIGH : LOW);
      }
      break;
  }
}
